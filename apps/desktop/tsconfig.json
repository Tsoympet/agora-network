{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "../shared/light-client/**/*.ts",
    "../shared/community/**/*.ts",
    "../shared/community-trust/**/*.ts"
  ],
  "exclude": [
    "../shared/light-client/**/*.test.ts",
    "../shared/community/**/*.test.ts",
    "../shared/community-trust/**/*.test.ts"
  ]
}
