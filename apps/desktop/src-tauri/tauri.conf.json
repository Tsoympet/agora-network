{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agora Network",
  "version": "0.1.0",
  "identifier": "network.agora.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "Agora Network",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Agora Network desktop wallet",
    "longDescription": "Agora Network light wallet: Bech32 receive, BIP-39 send, encrypted vault, and live DAG tip sync over JSON-RPC. Shows Devnet / Testnet / Mainnet from the connected node.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
