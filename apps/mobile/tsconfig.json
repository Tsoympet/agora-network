{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["react"]
  },
  "include": [
    "App.tsx",
    "DocsAboutPanel.tsx",
    "LightClientPanel.tsx",
    "PairingPanel.tsx",
    "FeatureSurfacesPanel.tsx",
    "community/**/*.tsx",
    "global.d.ts",
    "../shared/light-client/**/*.ts",
    "../shared/community/**/*.ts",
    "../shared/brand/tokens.ts"
  ],
  "exclude": ["../shared/light-client/**/*.test.ts", "../shared/community/**/*.test.ts"]
}
