{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["react"]
  },
  "include": [
    "App.tsx",
    "LightClientPanel.tsx",
    "PairingPanel.tsx",
    "FeatureSurfacesPanel.tsx",
    "ArchitecturePanel.tsx",
    "useVaultSessionTimeout.ts",
    "community/**/*.tsx",
    "global.d.ts",
    "../shared/light-client/**/*.ts",
    "../shared/community/**/*.ts",
    "../shared/core/**/*.ts",
    "../shared/wallet/**/*.ts",
    "../shared/lightclient/**/*.ts",
    "../shared/drc/**/*.ts",
    "../shared/ovl/**/*.ts",
    "../shared/tlt/**/*.ts",
    "../shared/passport/**/*.ts",
    "../shared/missions/**/*.ts",
    "../shared/academy/**/*.ts",
    "../shared/grants/**/*.ts",
    "../shared/bounties/**/*.ts",
    "../shared/guilds/**/*.ts",
    "../shared/merchants/**/*.ts",
    "../shared/events/**/*.ts",
    "../shared/assembly/**/*.ts",
    "../shared/treasury/**/*.ts",
    "../shared/forum/**/*.ts",
    "../shared/notifications/**/*.ts",
    "../shared/explorer/**/*.ts",
    "../shared/security/**/*.ts",
    "../shared/settings/**/*.ts",
    "../shared/moduleMap.ts",
    "../shared/index.ts",
    "../shared/brand/tokens.ts"
  ],
  "exclude": ["../shared/**/*.test.ts"]
}
